NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/thespotjobfinder
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# --- Google (Gmail) sign-in ---
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# Extra OAuth client IDs whose ID tokens are accepted (Flutter app: Android/iOS client IDs), comma-separated
GOOGLE_MOBILE_CLIENT_IDS=
# Optional: restrict sign-in to these domains, e.g. gmail.com
ALLOWED_EMAIL_DOMAINS=
# Comma separated emails that become master admins (manage all users, admins, daily search limits and the AI agents)
MASTER_ADMIN_EMAILS=
# Comma separated emails that become admins on first sign-in (portal jobs, AI import); the master admin can change roles later
ADMIN_EMAILS=
# Local testing only: shows an email-only login form (ignored when NODE_ENV=production)
DEV_LOGIN_ENABLED=false

# --- Job sources ---
# SerpAPI: Google Jobs (engine=google_jobs, India) plus Google web search of Naukri, Indeed,
# LinkedIn, Apna, WorkIndia, Internshala, X and company career pages.
SERPAPI_KEY=
# Alternative web search: Google Programmable Search Engine

GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Experimental: scrape Bing HTML when no search API key is set (often blocked / low quality)
ENABLE_FREE_SEARCH_FALLBACK=false
# Optional: Google Places key used to look up a company's public address / phone / website
GOOGLE_MAPS_API_KEY=
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# --- AI job agent (optional): plans queries and extracts facts grounded in the source page ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Scheduled AI auto-import of verified jobs (rules are managed in Admin). Checks for due rules every AUTO_IMPORT_TICK_MS.
AUTO_IMPORT_ENABLED=true
AUTO_IMPORT_TICK_MS=600000

# --- Google AdSense (user-facing pages only; never shown in Admin) ---
# Publisher ID from AdSense → Account → Account information, e.g. ca-pub-1234567890123456
ADSENSE_CLIENT_ID=
# Ad unit slot IDs from AdSense → Ads → By ad unit → Display ads
ADSENSE_SLOT_BANNER=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_INLINE=
ADSENSE_SLOT_RAIL=
# Adds data-adtest="on" so test impressions/clicks are not billed
ADSENSE_TEST_MODE=false
# Show demo ad creatives in slots that have no AdSense unit configured
ADSENSE_DEMO=true

# --- Mandatory video ad before every job search result ---
VIDEO_AD_REQUIRED=true
# Seconds of the ad that must actually play (tracked on the server) before results unlock
VIDEO_AD_SECONDS=30
# Admins skip the video ad
VIDEO_AD_EXEMPT_ADMINS=true
# Google video ad tag (AdSense for video / Ad Manager VAST tag, played with the Google IMA SDK).
# All ads come from Google; there is no admin form for creating or approving video ads.
# Google ads are usually 15-30 s, so ads are requested back to back until VIDEO_AD_SECONDS is reached.
# Google's public test tag:
# https://pubads.g.doubleclick.net/gampad/ads?iu=/21775744923/external/single_ad_samples&sz=640x480&cust_params=sample_ct%3Dlinear&ciu_szs=300x250%2C728x90&gdfp_req=1&output=vast&unviewed_position_start=1&env=vp&impl=s&correlator=
VIDEO_AD_VAST_TAG=
# Play the bundled demo video when no Google video ad is configured or none is available
VIDEO_AD_DEMO=true

# --- Google AdMob (Flutter mobile app) ---
# Ad unit IDs from AdMob → Apps → Ad units. Leave empty to use Google test banners (debug builds)
# and the timed video gate. For rewarded units, set the SSV callback URL in AdMob to
# https://<your-server>/api/admob/ssv so the server unlocks results only after Google confirms the reward.
ADMOB_ANDROID_BANNER_ID=
ADMOB_ANDROID_REWARDED_ID=
ADMOB_IOS_BANNER_ID=
ADMOB_IOS_REWARDED_ID=

# --- Limits ---
CRAWL_TIMEOUT_MS=10000
# Job search: per-user daily limit, jobs to enrich with contact details per search, time budget
# DAILY_JOB_SEARCH_LIMIT is only the starting default; the master admin changes it in Master Admin → Limits & AI agents
DAILY_JOB_SEARCH_LIMIT=5
JOB_ENRICH_LIMIT=12
JOB_SEARCH_BUDGET_MS=40000
